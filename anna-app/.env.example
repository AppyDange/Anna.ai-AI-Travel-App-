# ── Copy to .env and fill in. Never commit .env. ──────────────────────────────

# Claude — the conversational core.  https://console.anthropic.com
# Set a $50 spend cap in the console while you're there.
ANTHROPIC_API_KEY=

# Supabase — Postgres, auth, realtime.  https://supabase.com
# URL and ANON key are safe in the browser. SERVICE_ROLE bypasses row-level
# security and must never reach client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Amadeus — flights, hotels, airport/city lookup.  https://developers.amadeus.com
# Test tier is free and needs no card. Note the base URL differs in production.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# OpenRouteService — travel time between itinerary items (feasibility gate).
# https://openrouteservice.org  ·  free, no card
ORS_API_KEY=

# OpenTripMap — real points of interest, so activities aren't invented.
# https://opentripmap.io  ·  free, no card
OTM_API_KEY=

# Unsplash — destination imagery.  https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Travelpayouts — affiliate handoff. Apply early, approval takes days-to-weeks.
# https://travelpayouts.com  ·  leave blank until approved; handoff still works,
# it just earns nothing.
TRAVELPAYOUTS_MARKER=

# No key needed: Open-Meteo (weather), Frankfurter (currency).

# ── Runtime switches ──────────────────────────────────────────────────────────
# live   — call the real APIs (default)
# record — call them and snapshot responses into fixtures/
# replay — serve from fixtures/, no network, no cost
PROVIDER_MODE=live
